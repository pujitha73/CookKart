# Root-level shared placeholders (copy to appropriate .env files as needed)
# Do NOT store real credentials in version control.

# Supabase (shared identifiers; secrets must never be exposed to frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_PROJECT_REF=your-project-ref

# Backend (server-side only; keep in backend/.env)
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend (public-safe variables only; keep in frontend/.env)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000
